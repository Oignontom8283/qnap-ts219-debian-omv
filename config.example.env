# Copy to config.env (git-ignored) and fill in YOUR values. Nothing here is a real value.

# ---- identity of your NAS (see docs/01-hardware-recon.md) ----------------------------------
# UUID of the DATA array (md0), from QTS:  mdadm -E /dev/sda3 | grep UUID
MD0_UUID=00000000:00000000:00000000:00000000
# The NAS's REAL MAC address (QTS: /sbin/iface_get_mac eth0). Debian sets it via a systemd .link file.
NAS_MAC=aa:bb:cc:dd:ee:ff
# Hostname of the Debian system
NAS_HOSTNAME=nas

# ---- disk layout, from QTS: fdisk -lu /dev/sda  and  cat /proc/mdstat ----------------------
# Start sector of partition 2 (the swap partition, member of md2)
PART2_START_SECTOR=0
# Size of the md2 array in 512-byte sectors  (= blocks shown in /proc/mdstat * 2)
MD2_SECTORS=0

# ---- secrets used at build time (kept OUTSIDE git, see .gitignore) -------------------------
SSH_PUBKEY_FILE=./secrets/nas_ed25519.pub
ROOT_PASSWORD_FILE=./secrets/root_password.txt

# ---- build options ---------------------------------------------------------------------------
DEBIAN_SUITE=bookworm
